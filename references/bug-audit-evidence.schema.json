{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repository-bug-audit:bug-audit-evidence:3.0",
  "title": "Repository Bug Audit Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_mode",
    "generated_at",
    "project",
    "artifacts",
    "execution",
    "assessment",
    "coverage",
    "inventory",
    "core_flows",
    "verification_checks",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "audit_mode": { "enum": ["rapid", "comprehensive"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "project": { "$ref": "#/$defs/project" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "execution": { "$ref": "#/$defs/execution" },
    "assessment": { "$ref": "#/$defs/assessment" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inventoryItem" }
    },
    "core_flows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/coreFlow" }
    },
    "verification_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/verificationCheck" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimension" }
    },
    "total_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rating": {
      "enum": [
        "Strong engineering quality",
        "Generally good",
        "Material technical debt",
        "Elevated engineering risk",
        "Major engineering risk"
      ]
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "profile"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "profile": {
          "enum": [
            "web-network-service",
            "cli-desktop-application",
            "library-sdk",
            "data-pipeline-background-worker",
            "mixed"
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "evidence"],
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_mode", "provisional"],
      "properties": {
        "review_mode": { "enum": ["standard", "multi-agent"] },
        "provisional": { "type": "boolean" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "risk_rationale", "confidence", "confidence_rationale"],
      "properties": {
        "risk": { "enum": ["High", "Medium", "Low"] },
        "risk_rationale": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["High", "Medium", "Low"] },
        "confidence_rationale": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered_files",
        "in_scope_files",
        "read_files",
        "mapped_files",
        "unreadable_files",
        "excluded_files",
        "percentage",
        "critical_in_scope_files",
        "critical_read_files",
        "critical_percentage",
        "boundary"
      ],
      "properties": {
        "discovered_files": { "type": "integer", "minimum": 1 },
        "in_scope_files": { "type": "integer", "minimum": 1 },
        "read_files": { "type": "integer", "minimum": 0 },
        "mapped_files": { "type": "integer", "minimum": 0 },
        "unreadable_files": { "type": "integer", "minimum": 0 },
        "excluded_files": { "type": "integer", "minimum": 0 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "critical_in_scope_files": { "type": "integer", "minimum": 0 },
        "critical_read_files": { "type": "integer", "minimum": 0 },
        "critical_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "risk_tier"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["read", "mapped", "excluded", "unreadable"] },
        "risk_tier": { "enum": ["core", "high", "standard", "low"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "coreFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "risk_tier", "entry_point", "status", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "risk_tier": { "enum": ["core", "high"] },
        "entry_point": { "type": "string", "minLength": 1 },
        "status": { "enum": ["traced", "partial", "untraced"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "scope", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "not_run", "unavailable"] },
        "scope": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "fingerprint",
        "finding_type",
        "severity",
        "confidence",
        "category",
        "location",
        "summary",
        "evidence_kind",
        "evidence",
        "preconditions",
        "affected_surface",
        "impact",
        "recommendation",
        "verification",
        "source_agents",
        "status"
      ],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3}$" },
        "fingerprint": { "type": "string", "pattern": "^[a-z0-9_-]+\\|[a-z0-9_-]+\\|[a-z0-9_.:-]+$" },
        "finding_type": { "enum": ["defect", "risk", "quality-debt"] },
        "severity": { "enum": ["High", "Medium", "Low"] },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 10 },
        "category": {
          "enum": [
            "correctness",
            "security",
            "testing",
            "architecture",
            "readability",
            "dead-code",
            "performance",
            "operability"
          ]
        },
        "location": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_kind": { "enum": ["observed", "reproduced", "inferred"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "actual_behavior": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "string" },
        "affected_surface": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "recommendation": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "test_idea": { "type": "string", "minLength": 1 },
        "source_agents": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "enum": ["confirmed", "cross-confirmed", "needs-verification"] }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "level", "score", "rationale", "finding_ids"],
      "properties": {
        "id": {
          "enum": [
            "correctness",
            "security",
            "testing",
            "architecture",
            "readability",
            "dead_code",
            "performance_operability"
          ]
        },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "level": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "rationale": { "type": "string", "minLength": 1 },
        "finding_ids": { "type": "array", "items": { "type": "string" } },
        "na_reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
